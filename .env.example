# Template. Copy to .env (git-ignored) and fill in your own values.

# Connect AI auth -- Basic (email:PAT). Used by the Connect AI Gateway MCP endpoints below and by
# the harness-internal verifier.
CDATA_EMAIL=your-email@example.com
CDATA_ACCESS_TOKEN=your-connect-ai-pat

# Open-source MCP gateway: base URL of the proxy (the harness connects to its /mcp endpoint) and a
# gateway key, sent as "Authorization: Bearer <key>". The open-source gateway fronts separate CRM, warehouse
# and ITSM MCP servers. GATEWAY_ADMIN_KEY (the open-source gateway's admin key) is used only by
# setup/open_source_gateway/gateway_instructions.py to load the context.
GATEWAY_URL=http://localhost:4000
GATEWAY_KEY=sk-your-gateway-key
# GATEWAY_ADMIN_KEY=sk-your-gateway-admin-key

# Connect AI Gateway: its standard MCP endpoint, scoped by an ?ops= allowlist and
# authenticated with CDATA_EMAIL + CDATA_ACCESS_TOKEN. Read-only tools across all connections plus
# search_context, which reads the shared context entries (setup/connect_ai_gateway/context/).
CONNECT_AI_MCP_URL=https://mcp.cloud.cdata.com/mcp?ops=get_catalogs,get_schemas,get_tables,get_columns,get_instructions,queryData,search_context
# The same plus execute_insert (INSERT only), used by the write task (A1) to write REVIEW_QUEUE.
CONNECT_AI_MCP_WRITE_URL=https://mcp.cloud.cdata.com/mcp?ops=get_catalogs,get_schemas,get_tables,get_columns,get_instructions,queryData,execute_insert,search_context

# Harness-internal verifier (core/verifier.py) -- resets REVIEW_QUEUE before every A1 run and reads
# it back afterwards for scoring. Never given to a model under test: grading a write task through
# the same access being measured would be circular.
# Uses CData's general REST query API rather than MCP, because MCP's execute_insert rejects anything
# but INSERT and therefore cannot reset the table; the REST endpoint does accept DELETE.
# The Connect AI user needs Select and Delete on the warehouse connection (Delete for the reset),
# plus Insert if a condition writes through Connect AI. The CRM and ITSM connections need Select
# only; the verifier does not watch their tables for off-target writes.
#
# WH_CONN: the name of your warehouse connection in Connect AI. Used by the
# verifier to count DIM_ACCOUNT and TELEMETRY_EVENTS rows for off-target write detection.
# Use the warehouse connection name the context entries reference (setup/connect_ai_gateway/context/,
# e.g. dataset_dim_account.md), so the verifier and the context point at the same tables.
WH_CONN=<your-warehouse-connection>
# REVIEW_QUEUE_TABLE: full path to the REVIEW_QUEUE table, <connection>.WH_DATA.REVIEW_QUEUE.
REVIEW_QUEUE_TABLE=<your-warehouse-connection>.WH_DATA.REVIEW_QUEUE
# CDATA_QUERY_API: CData REST query endpoint the verifier calls. Defaults to the value below.
# CDATA_QUERY_API=https://cloud.cdata.com/api/query

# Provider API keys. Put them here (this file is loaded into the environment at startup)
# or export them in your shell -- either works. One key per line, no inline comments.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=...
XAI_API_KEY=xai-...

# Open-weight model keys; the name must match api_key_env in models.yaml. The current roster
# serves open-weight models through Together and Mistral. Local servers (Ollama) don't need an
# entry -- omit api_key_env in models.yaml.
TOGETHER_API_KEY=...
MISTRAL_API_KEY=...
# GROQ_API_KEY=...
